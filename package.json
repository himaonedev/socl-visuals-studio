{
  "name": "socl-visuals-v05",
  "productName": "SOCL Visuals Studio",
  "version": "2.4.41",
  "description": "SOCL Visuals Studio — Tauri 2 / Rust desktop host with a transitional Node video engine",
  "author": "SOCL Visuals Studio",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "ffmpeg-static": "5.3.0",
    "@tauri-apps/api": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.15",
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "electron@33.4.11": true,
    "@ffprobe-installer/darwin-arm64@5.0.1": true
  },
  "scripts": {
    "start": "node scripts/tauri.ts dev",
    "dev": "node scripts/dev-frontend.ts",
    "build": "node scripts/build-frontend.ts",
    "tauri": "node scripts/tauri.ts",
    "tauri:dev": "node scripts/tauri.ts dev",
    "tauri:build": "node scripts/tauri.ts build",
    "prepare:runtime": "node scripts/prepare-runtime.cjs",
    "typecheck": "tsc --noEmit && pnpm typecheck:backend && pnpm typecheck:legacy && pnpm typecheck:tooling",
    "typecheck:tooling": "tsc -p scripts/tsconfig.json",
    "build:backend": "node scripts/backend.cjs",
    "typecheck:backend": "node scripts/backend.cjs --check && tsc -p backend/tsconfig.json",
    "build:legacy": "node scripts/legacy-typescript.cjs",
    "typecheck:legacy": "node scripts/legacy-typescript.cjs --check && tsc -p frontend/legacy-src/tsconfig.json",
    "migration:status": "node scripts/migration-status.cjs",
    "test": "node scripts/backend.cjs && node scripts/prepare-ui.cjs && node --test tests/*.test.cjs",
    "test:editor": "vitest run --config vitest.config.mts"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-react": "^6.0.2",
    "vite": "^8.0.16",
    "typescript": "~6.0.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/node": "^26.6.5",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "vitest": "^5.0.3",
    "jsdom": "^30.1.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7"
  },
  "packageManager": "pnpm@8.6.11+sha1.35052eb3a470525c15ce915ca4f4012f44adfc18"
}
